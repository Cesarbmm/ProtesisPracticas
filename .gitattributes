# ETAPA E0P: los artefactos canonicos de la planta se versionan sin conversion de
# fin de linea, para que su hash sea identico en Windows y en Linux. El
# manifiesto de cada corrida guarda ese hash.
EMG_Prosthesis_TD3/matlab_code/src/@SimController/plant_limits_canonical.csv -text
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/plant_e0_regression_cases.csv -text
# MATLAB exporta CRLF en Windows; se conservan y se reconocen como fin de linea.
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e0p_results/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e0p_results/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# E2A conserva las trazas y manifiestos exportados por MATLAB sin conversion.
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e2a_results/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e2a_results/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# E2B: preservar los bytes de los artefactos medidos.
EMG_Prosthesis_TD3/docs/paired_reference/PREREGISTRO_E2B.md -text
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e2b_results/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/e2b_results/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Publicacion: preservar bytes y hashes del archivo cientifico copiado.
EMG_Prosthesis_TD3/matlab_code/analysis/paired_reference/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/tests/paired_reference/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/run*.m -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/matlab_code/*.m -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
EMG_Prosthesis_TD3/docs/paired_reference/** -text
PUBLICATION_MANIFEST.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Dos espacios al final son saltos de linea Markdown historicos.
*.md whitespace=-blank-at-eol
